{
  "name": "bouy",
  "version": "0.1.0",
  "description": "Actors as the execution primitive for TypeScript AI agents.",
  "license": "MIT",
  "bin": {
    "bouy": "./dist/cli.mjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./register": {
      "types": "./src/register.ts",
      "default": "./dist/register.mjs"
    },
    "./intrinsics": {
      "types": "./src/intrinsics.ts",
      "default": "./dist/intrinsics.mjs"
    },
    "./std": {
      "types": "./src/std.ts",
      "default": "./dist/std.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@bouy/checker": "workspace:*",
    "@bouy/compiler": "workspace:*",
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
