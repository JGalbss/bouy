-module(buoy@control_flow).
-export(['__init__'/0, earlyReturns/1, dispatch/1, switchWithBreaks/1, loops/1, nestedReturn/1, switchInLoop/1]).
-compile([no_auto_import, nowarn_unused_vars, nowarn_unused_function]).

'__init__'() -> ok.

earlyReturns(Args) ->
    N@1 = buoy_rt:arg(1, Args),
    case buoy_rt:lt(N@1, 0) of
        true -> <<"negative">>;
        false ->
            case buoy_rt:strict_eq(N@1, 0) of
                true -> <<"zero">>;
                false ->
                    Label@1 = <<"small">>,
                    {Label@5} = case buoy_rt:gt(N@1, 10) of
                        true ->
                            Label@2 = <<"large">>,
                            {Label@2};
                        false ->
                            {Label@4} = case buoy_rt:gt(N@1, 5) of
                                true ->
                                    Label@3 = <<"medium">>,
                                    {Label@3};
                                false -> {Label@1}
                            end,
                            {Label@4}
                    end,
                    Label@5
            end
    end.

dispatch(Args) ->
    Command@1 = buoy_rt:arg(1, Args),
    case Command@1 of
        <<"one">> -> 1;
        _ when Command@1 =:= <<"two">>; Command@1 =:= <<"deux">> -> 2;
        _ -> 0
    end.

switchWithBreaks(Args) ->
    N@1 = buoy_rt:arg(1, Args),
    Key@1 = buoy_rt:arg(2, Args),
    Total@1 = 0,
    {Total@4} = case N@1 of
        _ when N@1 == 1 ->
            Total@2 = 10,
            {Total@2};
        _ when N@1 == 2 ->
            case buoy_rt:strict_eq(Key@1, <<"skip">>) of
                true -> {Total@1};
                false ->
                    Total@3 = 20,
                    {Total@3}
            end;
        _ -> {Total@1}
    end,
    {Total@7} = case buoy_rt:strict_eq(Key@1, buoy_rt:call_method(Key@1, <<"toUpperCase">>, [])) of
        true ->
            Total@5 = buoy_rt:add(Total@4, 1),
            {Total@5};
        false ->
            Total@6 = buoy_rt:add(Total@4, 2),
            {Total@6}
    end,
    Total@7.

loops(Args) ->
    Xs@1 = buoy_rt:arg(1, Args),
    Sum@1 = 0,
    I@1 = 0,
    Loop@1 = fun Loop@1({Sum@2, I@2}) ->
        case buoy_rt:lt(I@2, buoy_rt:get(Xs@1, <<"length">>)) of
            true ->
                case buoy_rt:lt(buoy_rt:get(Xs@1, I@2), 0) of
                    true ->
                        I@3 = buoy_rt:sub(I@2, -1),
                        Loop@1({Sum@2, I@3});
                    false ->
                        case buoy_rt:gt(buoy_rt:get(Xs@1, I@2), 100) of
                            true -> {break, {Sum@2, I@2}};
                            false ->
                                Sum@3 = buoy_rt:add(Sum@2, buoy_rt:get(Xs@1, I@2)),
                                I@4 = buoy_rt:sub(I@2, -1),
                                Loop@1({Sum@3, I@4})
                        end
                end;
            false -> {break, {Sum@2, I@2}}
        end
    end,
    {break, {Sum@4, I@5}} = Loop@1({Sum@1, I@1}),
    K@1 = 0,
    Loop@2 = fun Loop@2({K@2}) ->
        case buoy_rt:lt(K@2, 3) of
            true ->
                K@3 = buoy_rt:sub(K@2, -1),
                Loop@2({K@3});
            false -> {break, {K@2}}
        end
    end,
    {break, {K@4}} = Loop@2({K@1}),
    Loop@3 = fun Loop@3({K@5}) ->
        K@6 = buoy_rt:sub(K@5, 1),
        case buoy_rt:gt(K@6, 1) of
            true -> Loop@3({K@6});
            false -> {break, {K@6}}
        end
    end,
    {break, {K@7}} = Loop@3({K@4}),
    Loop@4 = fun
        Loop@4([X@1 | Rest@1], {Sum@5}) ->
            Sum@6 = buoy_rt:add(Sum@5, X@1),
            Loop@4(Rest@1, {Sum@6});
        Loop@4([], T@1) -> {break, T@1}
    end,
    {break, {Sum@7}} = Loop@4(buoy_rt:to_list(Xs@1), {Sum@4}),
    Loop@5 = fun
        Loop@5([Key@1 | Rest@2], {Sum@8}) ->
            Sum@9 = buoy_rt:add(Sum@8, buoy_rt:get(Key@1, <<"length">>)),
            Loop@5(Rest@2, {Sum@9});
        Loop@5([], T@2) -> {break, T@2}
    end,
    {break, {Sum@10}} = Loop@5(buoy_rt:keys(#{<<"a">> => 1}), {Sum@7}),
    buoy_rt:add(Sum@10, K@7).

nestedReturn(Args) ->
    Grid@1 = buoy_rt:arg(1, Args),
    Loop@1 = fun
        Loop@1([Row@1 | Rest@1], {}) ->
            Loop@2 = fun
                Loop@2([Cell@1 | Rest@2], {}) ->
                    case buoy_rt:strict_eq(Cell@1, 0) of
                        true -> {return, <<"found">>};
                        false -> Loop@2(Rest@2, {})
                    end;
                Loop@2([], T@1) -> {break, T@1}
            end,
            case Loop@2(buoy_rt:to_list(Row@1), {}) of
                {break, {}} -> Loop@1(Rest@1, {});
                T@2 -> T@2
            end;
        Loop@1([], T@3) -> {break, T@3}
    end,
    case Loop@1(buoy_rt:to_list(Grid@1), {}) of
        {break, {}} -> <<"missing">>;
        {return, T@4} -> T@4
    end.

switchInLoop(Args) ->
    Items@1 = buoy_rt:arg(1, Args),
    Count@1 = 0,
    Loop@1 = fun
        Loop@1([Item@1 | Rest@1], {Count@2}) ->
            T@1 = case Item@1 of
                <<"skip">> -> {continue, {Count@2}};
                <<"stop">> -> {return, buoy_rt:negate(Count@2)};
                _ ->
                    Count@3 = buoy_rt:sub(Count@2, -1),
                    {next, {Count@3}}
            end,
            case T@1 of
                {next, {Count@4}} -> Loop@1(Rest@1, {Count@4});
                {continue, {Count@5}} -> Loop@1(Rest@1, {Count@5});
                T@2 -> T@2
            end;
        Loop@1([], T@3) -> {break, T@3}
    end,
    case Loop@1(buoy_rt:to_list(Items@1), {Count@1}) of
        {break, {Count@6}} -> Count@6;
        {return, T@4} -> T@4
    end.
