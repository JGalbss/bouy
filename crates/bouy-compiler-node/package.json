{
  "name": "@bouy/compiler",
  "version": "0.1.0",
  "description": "Node binding for the Bouy compiler, built with napi-rs.",
  "license": "MIT",
  "files": [
    "binding.js",
    "binding.d.ts",
    "*.node"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./binding.d.ts",
      "default": "./binding.js"
    }
  },
  "scripts": {
    "build": "napi build --platform --release --esm --js binding.js --dts binding.d.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8"
  },
  "napi": {
    "binaryName": "bouy-compiler"
  }
}
