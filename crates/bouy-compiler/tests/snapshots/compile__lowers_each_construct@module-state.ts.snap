---
source: crates/bouy-compiler/tests/compile.rs
expression: lower(path)
input_file: crates/bouy-compiler/tests/fixtures/module-state.ts
---
-module(bouy@module_state).
-export(['__init__'/0, useState/1]).
-compile([no_auto_import, nowarn_unused_vars, nowarn_unused_function]).

'__init__'() ->
    bouy_main:import(bouy@imported),
    TABLE@1 = bouy_map:new([[[<<"a">>, 1]]]),
    persistent_term:put({bouy@module_state, <<"TABLE">>}, TABLE@1),
    DERIVED@1 = bouy_rt:mul(
        bouy_rt:get(<<"hello">>, <<"length">>),
        persistent_term:get({bouy@imported, <<"LIMIT">>})
    ),
    persistent_term:put({bouy@module_state, <<"DERIVED">>}, DERIVED@1),
    persistent_term:put({bouy@module_state, <<"EXPORTED">>}, 42),
    bouy_console:log([<<"hello">>, DERIVED@1]),
    ok.

useState(Args) ->
    [
        <<"hello">>,
        bouy_rt:call_method(persistent_term:get({bouy@module_state, <<"TABLE">>}), <<"get">>, [<<"a">>]),
        persistent_term:get({bouy@module_state, <<"DERIVED">>}),
        bouy@imported:helper([1]),
        bouy@imported:helper([2]),
        persistent_term:get({bouy@imported, <<"LIMIT">>}),
        {'$class', bouy@imported, <<"Shape">>}
    ].
