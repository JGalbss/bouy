---
source: crates/bouy-compiler/tests/compile.rs
expression: lower(path)
input_file: crates/bouy-compiler/tests/fixtures/expressions.ts
---
-module(bouy@expressions).
-export(['__init__'/0, operators/1, comparisons/1, logical/1, literals/1, optional/1, destructure/1]).
-compile([no_auto_import, nowarn_unused_vars, nowarn_unused_function]).

'__init__'() -> ok.

operators(Args) ->
    A@1 = bouy_rt:arg(1, Args),
    B@1 = bouy_rt:arg(2, Args),
    S@1 = bouy_rt:arg(3, Args),
    [
        bouy_rt:add(A@1, B@1),
        bouy_rt:sub(A@1, B@1),
        bouy_rt:mul(A@1, B@1),
        bouy_rt:divide(A@1, B@1),
        bouy_rt:remainder(A@1, B@1),
        bouy_rt:power(A@1, B@1),
        bouy_rt:negate(A@1),
        bouy_rt:to_number(S@1),
        bouy_rt:bit_and(A@1, B@1),
        bouy_rt:bit_or(A@1, B@1),
        bouy_rt:bit_xor(A@1, B@1),
        bouy_rt:bit_not(A@1),
        bouy_rt:shift_left(A@1, B@1),
        bouy_rt:shift_right(A@1, B@1),
        bouy_rt:shift_right_unsigned(A@1, B@1)
    ].

comparisons(Args) ->
    A@1 = bouy_rt:arg(1, Args),
    B@1 = bouy_rt:arg(2, Args),
    [
        bouy_rt:strict_eq(A@1, B@1),
        not bouy_rt:strict_eq(A@1, B@1),
        bouy_rt:loose_eq(A@1, B@1),
        not bouy_rt:loose_eq(A@1, B@1),
        bouy_rt:lt(A@1, B@1),
        not bouy_rt:truthy(A@1),
        bouy_rt:strict_eq(bouy_rt:type_of(A@1), <<"string">>)
    ].

logical(Args) ->
    A@1 = bouy_rt:arg(1, Args),
    B@1 = bouy_rt:arg(2, Args),
    [
        case bouy_rt:truthy(A@1) of
            true -> B@1;
            false -> A@1
        end,
        case bouy_rt:truthy(A@1) of
            true -> A@1;
            false -> B@1
        end,
        case A@1 of
            T@1 when T@1 =:= null; T@1 =:= undefined -> B@1;
            T@2 -> T@2
        end,
        case bouy_rt:truthy(A@1) of
            true -> 1;
            false -> 2
        end,
        bouy_rt:has(B@1, <<"k">>),
        bouy_rt:instance_of(A@1, {'$class', bouy_error, <<"Error">>})
    ].

literals(Args) ->
    Name@1 = bouy_rt:arg(1, Args),
    List@1 = [1, 2.5, <<"three">>, true, null, undefined],
    Spread@1 = bouy_rt:array([{'$item', 0}, {'$spread', List@1}]),
    Object@1 = #{
        <<"name">> => Name@1,
        <<"nested">> => #{<<"deep">> => [1]},
        <<"quoted-key">> => 1
    },
    Merged@1 = bouy_rt:object([{'$spread', Object@1}, {<<"extra">>, Name@1}]),
    Computed@1 = #{bouy_rt:to_string(Name@1) => 1},
    [
        bouy_rt:concat([<<"hello ">>, Name@1, <<"!">>]),
        List@1,
        Spread@1,
        Merged@1,
        Computed@1,
        <<"plain">>
    ].

optional(Args) ->
    User@1 = bouy_rt:arg(1, Args),
    [
        case User@1 of
            null -> undefined;
            undefined -> undefined;
            T@1 ->
                case bouy_rt:get(T@1, <<"address">>) of
                    null -> undefined;
                    undefined -> undefined;
                    T@2 -> bouy_rt:get(T@2, <<"city">>)
                end
        end,
        case User@1 of
            null -> undefined;
            undefined -> undefined;
            T@3 ->
                begin
                    T@4 = T@3,
                    case bouy_rt:get(T@4, <<"greet">>) of
                        null -> undefined;
                        undefined -> undefined;
                        T@5 -> bouy_rt:call_method(T@4, <<"greet">>, [])
                    end
                end
        end,
        case case User@1 of
            null -> undefined;
            undefined -> undefined;
            T@6 ->
                case bouy_rt:get(T@6, <<"address">>) of
                    null -> undefined;
                    undefined -> undefined;
                    T@7 -> bouy_rt:get(T@7, <<"city">>)
                end
        end of
            T@8 when T@8 =:= null; T@8 =:= undefined -> <<"none">>;
            T@9 -> T@9
        end
    ].

destructure(Args) ->
    Input@1 = bouy_rt:arg(1, Args),
    A@1 = bouy_rt:get(Input@1, <<"a">>),
    T@2 = bouy_rt:to_list(case bouy_rt:get(Input@1, <<"b">>) of
        undefined -> [];
        T@1 -> T@1
    end),
    First@1 = bouy_rt:get(T@2, 0),
    Others@1 = bouy_rt:object_rest(Input@1, [<<"a">>, <<"b">>]),
    T@3 = bouy_rt:to_list([1, 2]),
    X@1 = bouy_rt:get(T@3, 0),
    Y@1 = case bouy_rt:get(T@3, 2) of
        undefined -> 3;
        T@4 -> T@4
    end,
    Tail@1 = bouy_rt:array_rest(T@3, 3),
    [A@1, First@1, Others@1, X@1, Y@1, Tail@1].
