---
source: crates/bouy-compiler/tests/compile.rs
expression: lower(path)
input_file: crates/bouy-compiler/tests/fixtures/libraries.ts
---
-module(bouy@libraries).
-export(['__init__'/0, globals/1]).
-compile([no_auto_import, nowarn_unused_vars, nowarn_unused_function]).

'__init__'() -> ok.

globals(Args) ->
    Text@1 = bouy_rt:arg(1, Args),
    bouy_console:log([
        bouy_math:max([1, 2]),
        bouy_math:'$member'(<<"PI">>),
        bouy_json:stringify([#{<<"a">> => 1}])
    ]),
    Parsed@1 = bouy_number:parseInt([Text@1, 10]),
    bouy:sleep([1]),
    All@1 = bouy_task:all([fun() -> bouy_task:resolve([1]) end, fun() -> bouy_task:resolve([2]) end]),
    Mapped@1 = bouy_task:map(
        [1, 2],
        fun(Args@1) ->
            X@1 = bouy_rt:arg(1, Args@1),
            bouy_rt:mul(X@1, 2)
        end,
        1
    ),
    Settled@1 = bouy_task:map_settled(
        [1, 2],
        fun(Args@2) ->
            X@2 = bouy_rt:arg(1, Args@2),
            bouy_rt:mul(X@2, 2)
        end,
        1
    ),
    First@1 = bouy_task:map_race(
        [1, 2],
        fun(Args@3) ->
            X@3 = bouy_rt:arg(1, Args@3),
            X@3
        end,
        1
    ),
    [
        Parsed@1,
        bouy_number:'$isNaN'([Parsed@1]),
        bouy_string:'$call'([Parsed@1]),
        bouy_number:'$call'([Text@1]),
        bouy_rt:truthy(Text@1),
        bouy_rt:call_method([1, 2], <<"map">>, [{'$namespace', bouy_string}]),
        bouy_rt:env(<<"HOME">>),
        bouy_rt:argv(),
        bouy_object:keys([#{<<"a">> => 1}]),
        bouy_map:new([]),
        bouy_error:'Error#new'([<<"e">>]),
        All@1,
        Mapped@1,
        Settled@1,
        First@1
    ].
