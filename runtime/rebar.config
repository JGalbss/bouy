{erl_opts, [debug_info, warnings_as_errors]}.

{eunit_opts, [verbose]}.

%% buoy_ai_openai starts inets and ssl on its first request, so a program
%% without AI calls does not pay for them at boot. The crypto binding loads
%% crypto and public_key on first use for the same reason.
{dialyzer, [{plt_apps, top_level_deps}, {plt_extra_apps, [inets, ssl, crypto, public_key]}]}.

%% rebar3 compiles src/ and its subsystem directories, and finds include/, by
%% default. EUnit reads test/ without its subdirectories unless asked.
{profiles, [{test, [{extra_src_dirs, [{"test", [{recursive, true}]}]}]}]}.
