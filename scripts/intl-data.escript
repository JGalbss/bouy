#!/usr/bin/env escript
%% Writes runtime/src/builtins/intl/buoy_ref_intl_data.erl, the CLDR data of Intl that
%% ICU4X does not give: the values of Intl.supportedValuesOf, and the calendar, hour
%% cycle, week, and time zone data of each region that Intl.Locale reports.
%%
%% Usage: scripts/intl-data.escript <cldr-json-dir> <output.erl>
%%
%% <cldr-json-dir> is the cldr-json directory of the cldr-json release that Node's ICU uses
%% (process.versions.cldr), such as https://github.com/unicode-org/cldr-json/tree/48.0.0,
%% with cldr-bcp47/bcp47/timezone.json and
%% cldr-core/supplemental/{calendarPreferenceData,timeData,weekData,numberingSystems,
%% currencyData}.json, and cldr-core/{availableLocales,defaultContent}.json.
-mode(compile).

main([Dir, Output]) ->
    Read = fun(Path) ->
                   {ok, Text} = file:read_file(filename:join(Dir, Path)),
                   json:decode(Text)
           end,
    Bcp47 = fun(Name) -> maps:get(<<"u">>, maps:get(<<"keyword">>, Read("cldr-bcp47/bcp47/" ++ Name ++ ".json"))) end,
    Supplemental = fun(Name) -> maps:get(list_to_binary(Name), maps:get(<<"supplemental">>, Read("cldr-core/supplemental/" ++ Name ++ ".json"))) end,
    Zones = zones(maps:get(<<"tz">>, Bcp47("timezone"))),
    %% The release is the name of the checkout, cldr-json-<version>, around cldr-json.
    Version = string:prefix(filename:basename(filename:dirname(filename:absname(Dir))), "cldr-json-"),
    Available = maps:get(<<"full">>, maps:get(<<"availableLocales">>, Read("cldr-core/availableLocales.json"))),
    DefaultContent = maps:get(<<"defaultContent">>, Read("cldr-core/defaultContent.json")),
    Body = [header(),
            list_function("available_locales", "The locales of CLDR and their default content locales, such as en-US (the [[AvailableLocales]] of each service).",
                          lists:usort(Available ++ DefaultContent)),
            list_function("calendars", "The calendars of Temporal and DateTimeFormat (AvailableCalendars).", calendars()),
            list_function("currencies", "The ISO 4217 codes of the currencies in use (AvailableCanonicalCurrencies).",
                          currencies(Supplemental("currencyData"))),
            list_function("numbering_systems", "The numbering systems with simple digits (AvailableCanonicalNumberingSystems).",
                          numbering_systems(Supplemental("numberingSystems"))),
            list_function("time_zones", "The primary identifiers of the IANA time zones (AvailableNamedTimeZoneIdentifiers).",
                          lists:usort([Name || {Name, _Region} <- Zones])),
            list_function("units", "The simple units that ECMA-402 sanctions, which NumberFormat formats.", units()),
            region_function("region_calendars", "The calendars in use in a region, most preferred first, or [].",
                            [{R, [calendar_type(C) || C <- Cs]} || {R, Cs} <- maps:to_list(Supplemental("calendarPreferenceData"))], "[]"),
            region_function("hour_cycle", "The preferred hour cycle of a region or of a language_REGION, or none.",
                            hour_cycles(Supplemental("timeData")), "none"),
            region_function("week", "{FirstDay, Weekend} of a region, with ISO day numbers, or none.",
                            weeks(Supplemental("weekData")), "none"),
            region_function("region_time_zones", "The primary time zone identifiers of a region, sorted, or [].",
                            group(Zones), "[]")],
    ok = file:write_file(Output, [io_lib:format("%% Generated by scripts/intl-data.escript from cldr-json ~s. Do not edit.~n", [Version]) | Body]);
main(_) ->
    io:format(standard_error, "usage: scripts/intl-data.escript <cldr-json-dir> <output.erl>~n", []),
    halt(1).

header() ->
    ["%% The CLDR data of Intl that ICU4X does not give (buoy_ref_intl, buoy_ref_intl_locale).\n",
     "-module(buoy_ref_intl_data).\n\n",
     "-export([available_locales/0, calendars/0, currencies/0, numbering_systems/0, time_zones/0, units/0]).\n",
     "-export([region_calendars/1, hour_cycle/1, week/1, region_time_zones/1]).\n"].

list_function(Name, Doc, Items) ->
    io_lib:format("~n%% ~s~n-spec ~s() -> [binary()].~n~s() ->~n    [~s].~n",
                  [Doc, Name, Name, lists:join(", ", [["<<\"", I, "\">>"] || I <- Items])]).

region_function(Name, Doc, Pairs, Default) ->
    Clauses = [io_lib:format("~s(<<\"~s\">>) -> ~s;~n", [Name, K, term(V)]) || {K, V} <- lists:sort(Pairs)],
    io_lib:format("~n%% ~s~n-spec ~s(binary()) -> term().~n~s~s(_) -> ~s.~n", [Doc, Name, Clauses, Name, Default]).

term(V) when is_binary(V) -> ["<<\"", V, "\">>"];
term(V) when is_list(V) -> ["[", lists:join(", ", [term(E) || E <- V]), "]"];
term({A, B}) -> ["{", term(A), ", ", term(B), "}"];
term(V) when is_integer(V) -> integer_to_list(V).

%% The calendars that Temporal and Intl.DateTimeFormat support: the list of
%% the Intl era and month code proposal.
calendars() ->
    [<<"buddhist">>, <<"chinese">>, <<"coptic">>, <<"dangi">>, <<"ethioaa">>, <<"ethiopic">>, <<"gregory">>,
     <<"hebrew">>, <<"indian">>, <<"islamic-civil">>, <<"islamic-tbla">>, <<"islamic-umalqura">>, <<"iso8601">>,
     <<"japanese">>, <<"persian">>, <<"roc">>].

%% The CLDR names of calendar preference data as their BCP 47 types.
calendar_type(<<"gregorian">>) -> <<"gregory">>;
calendar_type(<<"ethiopic-amete-alem">>) -> <<"ethioaa">>;
calendar_type(Name) -> Name.

currencies(Data) ->
    lists:usort([C || {_Region, Entries} <- maps:to_list(maps:get(<<"region">>, Data)), Entry <- Entries,
                      {C, V} <- maps:to_list(Entry), not maps:is_key(<<"_to">>, V),
                      maps:get(<<"_tender">>, V, <<"true">>) =/= <<"false">>]).

numbering_systems(Data) ->
    lists:sort([K || {K, V} <- maps:to_list(Data), maps:get(<<"_type">>, V) =:= <<"numeric">>]).

%% Table 1 of ECMA-402: the simple units that NumberFormat formats.
units() ->
    [<<"acre">>, <<"bit">>, <<"byte">>, <<"celsius">>, <<"centimeter">>, <<"day">>, <<"degree">>, <<"fahrenheit">>,
     <<"fluid-ounce">>, <<"foot">>, <<"gallon">>, <<"gigabit">>, <<"gigabyte">>, <<"gram">>, <<"hectare">>,
     <<"hour">>, <<"inch">>, <<"kilobit">>, <<"kilobyte">>, <<"kilogram">>, <<"kilometer">>, <<"liter">>,
     <<"megabit">>, <<"megabyte">>, <<"meter">>, <<"microsecond">>, <<"mile">>, <<"mile-scandinavian">>,
     <<"milliliter">>, <<"millimeter">>, <<"millisecond">>, <<"minute">>, <<"month">>, <<"nanosecond">>,
     <<"ounce">>, <<"percent">>, <<"petabyte">>, <<"pound">>, <<"second">>, <<"stone">>, <<"terabit">>,
     <<"terabyte">>, <<"week">>, <<"yard">>, <<"year">>].

%% The preferred hour cycle of each region or language_REGION of timeData.
hour_cycles(Data) ->
    [{K, hour_cycle(binary:first(maps:get(<<"_preferred">>, V)))} || {K, V} <- maps:to_list(Data)].

hour_cycle($h) -> <<"h12">>;
hour_cycle($H) -> <<"h23">>;
hour_cycle($K) -> <<"h11">>;
hour_cycle($k) -> <<"h24">>.

%% {FirstDay, [WeekendDay]} of each region of weekData, with 1 for Monday and
%% 7 for Sunday. A region without its own weekend has that of 001.
weeks(Data) ->
    First = maps:get(<<"firstDay">>, Data),
    Start = maps:get(<<"weekendStart">>, Data),
    End = maps:get(<<"weekendEnd">>, Data),
    Regions = lists:usort(maps:keys(First) ++ maps:keys(Start) ++ maps:keys(End)),
    [{R, {day(maps:get(R, First, maps:get(<<"001">>, First))),
          weekend(day(maps:get(R, Start, maps:get(<<"001">>, Start))), day(maps:get(R, End, maps:get(<<"001">>, End))))}}
     || R <- Regions, binary:match(R, <<"-">>) =:= nomatch].

day(<<"mon">>) -> 1;
day(<<"tue">>) -> 2;
day(<<"wed">>) -> 3;
day(<<"thu">>) -> 4;
day(<<"fri">>) -> 5;
day(<<"sat">>) -> 6;
day(<<"sun">>) -> 7.

weekend(Start, End) when Start =< End -> lists:seq(Start, End);
weekend(Start, End) -> lists:seq(Start, 7) ++ lists:seq(1, End).

%% {PrimaryIdentifier, Region} of each time zone of bcp47/timezone.json that is
%% not deprecated: the IANA name of "_iana", else the first alias, and the
%% region of "_region", else the first two letters of the key. Etc/UTC is UTC.
zones(Tz) ->
    [{primary(K, V), region(K, V)} || {K, V} <- maps:to_list(Tz), is_map(V), maps:is_key(<<"_alias">>, V),
                                      not maps:get(<<"_deprecated">>, V, false), K =/= <<"unk">>].

primary(_K, #{<<"_iana">> := Name}) -> utc(Name);
primary(_K, #{<<"_alias">> := Aliases}) -> utc(hd(binary:split(Aliases, <<" ">>))).

%% CanonicalizeTimeZoneName of ECMA-402: Etc/UTC and Etc/GMT are UTC.
utc(<<"Etc/UTC">>) -> <<"UTC">>;
utc(<<"Etc/GMT">>) -> <<"UTC">>;
utc(Name) -> Name.

region(_K, #{<<"_region">> := R}) -> R;
region(<<A, B, _/binary>>, _V) -> string:uppercase(<<A, B>>).

group(Zones) ->
    Regions = lists:usort([R || {_, R} <- Zones]),
    [{R, lists:usort([N || {N, R1} <- Zones, R1 =:= R])} || R <- Regions].
