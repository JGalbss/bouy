#!/usr/bin/env escript
%% Writes runtime/src/builtins/intl/buoy_intl_aliases.erl, the aliases of the values of
%% the -u- and -t- extensions of a Unicode locale identifier, which ICU4X's
%% LocaleCanonicalizer leaves as they are (UTS #35, Annex C: canonicalize the -u- type
%% and -t- field values).
%%
%% Usage: scripts/intl-aliases.escript <bcp47-dir> <output.erl>
%%
%% <bcp47-dir> holds the files of cldr-json/cldr-bcp47/bcp47 of the CLDR release that
%% Node's ICU uses (process.versions.cldr), such as
%% https://github.com/unicode-org/cldr-json/tree/48.0.0/cldr-json/cldr-bcp47/bcp47.
%% A deprecated value with "_preferred" maps to the preferred value, and each "_alias" of
%% a value that is not deprecated, when it is valid type syntax (subtags of 3 to 8 letters
%% and digits), maps to the value.
-mode(compile).

main([Dir, Output]) ->
    Files = lists:sort(filelib:wildcard(filename:join(Dir, "*.json"))),
    Pairs = lists:usort(lists:flatmap(fun pairs/1, Files)),
    Clauses = [io_lib:format("value(<<\"~s\">>, <<\"~s\">>) -> <<\"~s\">>;~n", [K, A, V]) || {K, A, V} <- Pairs],
    Version = string:prefix(filename:basename(filename:dirname(filename:dirname(filename:dirname(filename:absname(Dir))))), "cldr-json-"),
    ok = file:write_file(Output, [header(Version), Clauses, "value(_Key, Value) -> Value.\n"]);
main(_) ->
    io:format(standard_error, "usage: scripts/intl-aliases.escript <bcp47-dir> <output.erl>~n", []),
    halt(1).

header(Version) ->
    ["%% Generated by scripts/intl-aliases.escript from cldr-json ", Version, " (cldr-bcp47). Do not edit.\n",
     "%% The canonical value of each aliased or deprecated value of a key of the -u- or -t-\n",
     "%% extension of a Unicode locale identifier (UTS #35, Annex C).\n",
     "-module(buoy_intl_aliases).\n\n",
     "-export([value/2]).\n\n",
     "-spec value(binary(), binary()) -> binary().\n"].

%% {Key, Alias, Value} for each alias of a value of the file.
pairs(File) ->
    {ok, Text} = file:read_file(File),
    #{<<"keyword">> := Keyword} = json:decode(Text),
    [Pair || {_Extension, Keys} <- maps:to_list(Keyword), {Key, Values} <- maps:to_list(Keys), is_map(Values),
             {Value, Entry} <- maps:to_list(Values), is_map(Entry), Pair <- aliases(Key, Value, Entry)].

aliases(Key, Value, Entry) ->
    Preferred = case Entry of
        #{<<"_preferred">> := P} -> [{lower(Key), lower(Value), lower(P)}];
        _ -> []
    end,
    Named = case Entry of
        #{<<"_deprecated">> := true} -> [];
        #{<<"_alias">> := Names} ->
            [{lower(Key), lower(Name), lower(Value)} || Name <- binary:split(Names, <<" ">>, [global, trim_all]),
                                                       is_type(lower(Name)), lower(Name) =/= lower(Value)];
        _ -> []
    end,
    Preferred ++ Named.

%% A type value of UTS #35: subtags of 3 to 8 letters and digits.
is_type(Name) ->
    lists:all(fun(Subtag) -> byte_size(Subtag) >= 3 andalso byte_size(Subtag) =< 8 andalso
                             lists:all(fun(C) -> (C >= $a andalso C =< $z) orelse (C >= $0 andalso C =< $9) end,
                                       binary_to_list(Subtag))
              end, binary:split(Name, <<"-">>, [global])).

lower(B) -> string:lowercase(B).
