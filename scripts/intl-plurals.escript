#!/usr/bin/env escript
%% Writes runtime/src/builtins/intl/buoy_intl_plurals.erl, the plural rules of CLDR:
%% the cardinal and ordinal rules of each language as Erlang guards, their categories,
%% and the plural ranges. ICU4C, which Node bundles, holds the rules of every language
%% of CLDR; ICU4X's compiled data holds only those of its recommended locales.
%%
%% Usage: scripts/intl-plurals.escript <supplemental-dir> <output.erl>
%%
%% <supplemental-dir> is cldr-json/cldr-core/supplemental of the cldr-json release that
%% Node's ICU uses (process.versions.cldr), such as
%% https://github.com/unicode-org/cldr-json/tree/48.0.0/cldr-json/cldr-core/supplemental,
%% with plurals.json, ordinals.json, and pluralRanges.json.
-mode(compile).

main([Dir, Output]) ->
    Read = fun(Name, Key) ->
                   {ok, Text} = file:read_file(filename:join(Dir, Name)),
                   maps:get(Key, maps:get(<<"supplemental">>, json:decode(Text)))
           end,
    Cardinal = Read("plurals.json", <<"plurals-type-cardinal">>),
    Ordinal = Read("ordinals.json", <<"plurals-type-ordinal">>),
    Ranges = Read("pluralRanges.json", <<"plurals">>),
    Version = string:prefix(filename:basename(filename:dirname(filename:dirname(filename:dirname(filename:absname(Dir))))),
                            "cldr-json-"),
    Body = [header(Version),
            rules_function(cardinal, Cardinal), rules_function(ordinal, Ordinal),
            categories_function(Cardinal, Ordinal), ranges_function(Ranges)],
    ok = file:write_file(Output, Body);
main(_) ->
    io:format(standard_error, "usage: scripts/intl-plurals.escript <supplemental-dir> <output.erl>~n", []),
    halt(1).

header(Version) ->
    ["%% Generated by scripts/intl-plurals.escript from cldr-json ", Version, " (cldr-core). Do not edit.\n",
     "%% The plural rules of CLDR (UTS #35 part 3, section 5): select/3 takes the operands\n",
     "%% {I, V, W, F, T, C} of a decimal, where n is I when T is 0 and not an integer otherwise.\n",
     "-module(buoy_intl_plurals).\n\n",
     "-export([cardinal/2, ordinal/2, categories/2, range/3]).\n",
     "-export_type([operands/0]).\n\n",
     "-type operands() :: {non_neg_integer(), non_neg_integer(), non_neg_integer(), non_neg_integer(),\n",
     "                     non_neg_integer(), non_neg_integer()}.\n"].

%% cardinal/2 or ordinal/2: the category of the operands for the rule set of a
%% language of plurals.json, or none for a name without rules.
rules_function(Type, Sets) ->
    Clauses = [rule_clause(Type, Locale, maps:to_list(Rules)) || {Locale, Rules} <- lists:sort(maps:to_list(Sets))],
    io_lib:format("~n-spec ~s(binary(), operands()) -> binary() | none.~n~s~s(_, _) -> none.~n", [Type, Clauses, Type]).

rule_clause(Type, Locale, Rules) ->
    Conditions = [{category(Key), condition(Text)} || {Key, Text} <- lists:sort(fun order/2, Rules),
                                                       category(Key) =/= <<"other">>],
    Used = lists:usort(lists:append([operands_of(Text) || {_, Text} <- Rules])),
    Head = ["{", lists:join(", ", [variable(O, Used) || O <- ["i", "v", "w", "f", "t", "c"]]), "}"],
    case Conditions of
        [] -> io_lib:format("~s(<<\"~s\">>, _) -> <<\"other\">>;~n", [Type, Locale]);
        _ ->
            Branches = [io_lib:format("        ~s -> <<\"~s\">>;~n", [Guard, Category]) || {Category, Guard} <- Conditions],
            io_lib:format("~s(<<\"~s\">>, ~s) ->~n    if~n~s        true -> <<\"other\">>~n    end;~n",
                          [Type, Locale, Head, Branches])
    end.

order({A, _}, {B, _}) -> rank(category(A)) =< rank(category(B)).

rank(C) -> length(lists:takewhile(fun(X) -> X =/= C end, categories_in_order())).

categories_in_order() -> [<<"zero">>, <<"one">>, <<"two">>, <<"few">>, <<"many">>, <<"other">>].

category(<<"pluralRule-count-", Category/binary>>) -> Category.

%% The variable of an operand in a clause head: n reads i and t, and e is c.
variable(O, Used) ->
    Upper = string:uppercase(O),
    case lists:member(O, Used) of
        true -> Upper;
        false -> "_" ++ Upper
    end.

operands_of(Text) ->
    lists:usort(lists:flatmap(fun("n") -> ["i", "t"]; ("e") -> ["c"]; (O) -> [O] end,
                              [T || T <- tokens(rule_text(Text)), lists:member(T, ["n", "i", "v", "w", "f", "t", "c", "e"])])).

%% The rule without its samples.
rule_text(Text) -> string:trim(hd(string:split(binary_to_list(Text), "@"))).

tokens(Text) ->
    case re:run(Text, "\\d+\\.\\.\\d+|\\d+|[a-z]+|!=|=|%|,", [global, {capture, all, list}]) of
        {match, Tokens} -> [T || [T] <- Tokens];
        nomatch -> []
    end.

%% A guard for the rule: or of ands of relations.
condition(Text) ->
    Ors = split(tokens(rule_text(Text)), "or"),
    lists:join(" orelse ", [["(", lists:join(" andalso ", [relation(R) || R <- split(And, "and")]), ")"]
                            || And <- Ors]).

split(Tokens, Word) ->
    lists:foldr(fun(T, [Current | Done]) when T =:= Word -> [[], Current | Done];
                   (T, [Current | Done]) -> [[T | Current] | Done]
                end, [[]], Tokens).

relation([Operand, "%", Modulus, Op | Values]) -> relation(Operand, ["(", value(Operand), " rem ", Modulus, ")"], Op, Values);
relation([Operand, Op | Values]) -> relation(Operand, value(Operand), Op, Values).

relation(Operand, Expression, Op, Values) ->
    Test = ["(", lists:join(" orelse ", [member(Expression, V) || V <- Values, V =/= ","]), ")"],
    Integral = case Operand of
        "n" -> ["T =:= 0 andalso ", Test];
        _ -> Test
    end,
    case Op of
        "=" -> ["(", Integral, ")"];
        "!=" -> ["not (", Integral, ")"]
    end.

value("n") -> "I";
value("e") -> "C";
value(O) -> string:uppercase(O).

member(Expression, Range) ->
    case string:split(Range, "..") of
        [Low, High] -> ["(", Expression, " >= ", Low, " andalso ", Expression, " =< ", High, ")"];
        [Value] -> [Expression, " =:= ", Value]
    end.

%% categories/2: the categories of a rule set in the order of ECMA-402.
categories_function(Cardinal, Ordinal) ->
    Clauses = [io_lib:format("categories(~s, <<\"~s\">>) -> [~s];~n",
                             [Type, Locale, lists:join(", ", [["<<\"", C, "\">>"] || C <- present(Rules)])])
               || {Type, Sets} <- [{cardinal, Cardinal}, {ordinal, Ordinal}], {Locale, Rules} <- lists:sort(maps:to_list(Sets))],
    io_lib:format("~n-spec categories(cardinal | ordinal, binary()) -> [binary()] | none.~n~scategories(_, _) -> none.~n",
                  [Clauses]).

present(Rules) ->
    Categories = [category(K) || K <- maps:keys(Rules)],
    [C || C <- categories_in_order(), lists:member(C, Categories)].

%% range/3: the category of a range of the two categories, or none for a pair
%% that pluralRanges.json does not list.
ranges_function(Ranges) ->
    Clauses = [io_lib:format("range(<<\"~s\">>, <<\"~s\">>, <<\"~s\">>) -> <<\"~s\">>;~n", [Locale, Start, End, Result])
               || {Locale, Pairs} <- lists:sort(maps:to_list(Ranges)), {Key, Result} <- lists:sort(maps:to_list(Pairs)),
                  [Start, End] <- [range_key(Key)]],
    io_lib:format("~n-spec range(binary(), binary(), binary()) -> binary() | none.~n~srange(_, _, _) -> none.~n", [Clauses]).

range_key(<<"pluralRange-start-", Rest/binary>>) ->
    [Start, End] = binary:split(Rest, <<"-end-">>),
    [Start, End].
